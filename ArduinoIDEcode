#include <Servo.h>

// ---------- PIN DEFINITIONS ----------
#define TRIG_PIN 9
#define ECHO_PIN 10
#define IR_PIN 7

#define RADAR_SERVO_PIN   6
#define TRIGGER_SERVO_PIN 5

// ---------- CONSTANTS ----------
#define MAX_RANGE 50        // cm
#define TRIGGER_IDLE 20
#define TRIGGER_FIRE 70

// ---------- OBJECTS ----------
Servo radarServo;
Servo triggerServo;

// ---------- VARIABLES ----------
long duration;
int distance;
int irState;

int angle = 10;             // start angle
int direction = 1;          // 1 = forward, -1 = backward

// ---------- SETUP ----------
void setup() {
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  pinMode(IR_PIN, INPUT);

  radarServo.attach(RADAR_SERVO_PIN);
  triggerServo.attach(TRIGGER_SERVO_PIN);

  radarServo.write(angle);
  triggerServo.write(TRIGGER_IDLE);

  Serial.begin(9600);
  delay(300);
}

// ---------- MAIN LOOP ----------
void loop() {
  scanAndReact(angle);

  // Update angle smoothly within ONE 180° sector
  angle += direction * 2;

  if (angle >= 170) {
    angle = 170;
    direction = -1;
  } 
  else if (angle <= 10) {
    angle = 10;
    direction = 1;
  }
}

// ---------- SCAN + REACT ----------
void scanAndReact(int currentAngle) {
  radarServo.write(currentAngle);
  delay(25);

  distance = readUltrasonic();
  irState = digitalRead(IR_PIN);  // ACTIVE-LOW

  // Send data to Processing
  Serial.print(currentAngle);
  Serial.print(",");
  Serial.print(distance);
  Serial.print(",");
  Serial.println(irState);

  // Trigger condition
  if (irState == LOW && distance < 30) {
    fireTrigger();
  }
}

// ---------- TRIGGER SERVO ----------
void fireTrigger() {
  triggerServo.write(TRIGGER_FIRE);
  delay(300);
  triggerServo.write(TRIGGER_IDLE);
  delay(500);   // cooldown
}

// ---------- ULTRASONIC FUNCTION ----------
int readUltrasonic() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);

  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  duration = pulseIn(ECHO_PIN, HIGH, 30000);
  if (duration == 0) return MAX_RANGE;

  int d = duration * 0.034 / 2;
  if (d > MAX_RANGE) d = MAX_RANGE;

  return d;
}
