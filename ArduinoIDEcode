#include <Servo.h>

// ---------------- PIN DEFINITIONS ----------------
#define TRIG_PIN 9
#define ECHO_PIN 10
#define IR_PIN 7

#define RADAR_SERVO_PIN   6
#define TRIGGER_SERVO_PIN 5

// ---------------- CONSTANTS ----------------
#define MAX_RANGE 50        // cm
#define TRACK_RANGE 30      // cm (tracking distance)
#define TRIGGER_IDLE 20
#define TRIGGER_FIRE 70

#define ANGLE_MIN 10
#define ANGLE_MAX 170
#define STEP_SIZE 2

// ---------------- OBJECTS ----------------
Servo radarServo;
Servo triggerServo;

// ---------------- VARIABLES ----------------
long duration;
int distance;
int irState;

// Radar motion
int angle = ANGLE_MIN;
int direction = 1;

// Tracking
bool trackingMode = false;
int targetAngle = 90;

// ---------------- SETUP ----------------
void setup() {
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  pinMode(IR_PIN, INPUT);

  radarServo.attach(RADAR_SERVO_PIN);
  triggerServo.attach(TRIGGER_SERVO_PIN);

  radarServo.write(angle);
  triggerServo.write(TRIGGER_IDLE);

  Serial.begin(9600);
  delay(300);
}

// ---------------- MAIN LOOP ----------------
void loop() {

  if (!trackingMode) {
    // -------- SCANNING MODE --------
    scanAndDetect();

    angle += direction * STEP_SIZE;

    if (angle >= ANGLE_MAX) {
      angle = ANGLE_MAX;
      direction = -1;
    } 
    else if (angle <= ANGLE_MIN) {
      angle = ANGLE_MIN;
      direction = 1;
    }

  } else {
    // -------- TRACKING MODE --------
    trackTarget();
  }
}

// ---------------- SCAN MODE ----------------
void scanAndDetect() {
  radarServo.write(angle);
  delay(25);

  distance = readUltrasonic();
  irState = digitalRead(IR_PIN);  // ACTIVE-LOW

  // Send data to Processing
  sendSerial(angle, distance, irState);

  // Enter tracking mode
  if (irState == LOW && distance < TRACK_RANGE) {
    trackingMode = true;
    targetAngle = angle;
  }
}

// ---------------- TRACKING MODE ----------------
void trackTarget() {

  radarServo.write(targetAngle);
  delay(25);

  int centerDist = readUltrasonic();
  int leftDist, rightDist;

  // Check if target lost
  irState = digitalRead(IR_PIN);
  if (irState == HIGH || centerDist >= MAX_RANGE) {
    trackingMode = false;
    return;
  }

  // Sample left
  radarServo.write(targetAngle - STEP_SIZE);
  delay(15);
  leftDist = readUltrasonic();

  // Sample right
  radarServo.write(targetAngle + STEP_SIZE);
  delay(15);
  rightDist = readUltrasonic();

  // Decide direction
  if (leftDist < rightDist && targetAngle > ANGLE_MIN) {
    targetAngle -= STEP_SIZE;
  } 
  else if (rightDist < leftDist && targetAngle < ANGLE_MAX) {
    targetAngle += STEP_SIZE;
  }

  // Fire condition (optional)
  if (centerDist < 20) {
    fireTrigger();
  }

  sendSerial(targetAngle, centerDist, irState);
}

// ---------------- TRIGGER SERVO ----------------
void fireTrigger() {
  triggerServo.write(TRIGGER_FIRE);
  delay(300);
  triggerServo.write(TRIGGER_IDLE);
  delay(500);
}

// ---------------- ULTRASONIC FUNCTION ----------------
int readUltrasonic() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);

  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  duration = pulseIn(ECHO_PIN, HIGH, 30000);
  if (duration == 0) return MAX_RANGE;

  int d = duration * 0.034 / 2;
  if (d > MAX_RANGE) d = MAX_RANGE;

  return d;
}

// ---------------- SERIAL FORMAT ----------------
void sendSerial(int a, int d, int ir) {
  Serial.print(a);
  Serial.print(",");
  Serial.print(d);
  Serial.print(",");
  Serial.println(ir);
}